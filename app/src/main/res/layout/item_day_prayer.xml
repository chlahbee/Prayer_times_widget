<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingHorizontal="6dp"
    android:weightSum="7"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <!-- Day & Date -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1.1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/tv_day_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الخميس"
            android:textSize="11sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="@color/config_text_primary"/>
        <TextView
            android:id="@+id/tv_day_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01/10"
            android:textSize="9sp"
            android:includeFontPadding="false"
            android:textColor="@color/config_text_secondary"/>
    </LinearLayout>

    <!-- Fajr -->
    <TextView
        android:id="@+id/tv_fajr"
        android:layout_width="0dp"
        android:layout_weight="0.98"
        android:layout_height="wrap_content"
        android:text="04:51"
        android:textSize="11sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:gravity="center"
        android:textColor="@color/config_text_primary"/>

    <!-- Sunrise -->
    <TextView
        android:id="@+id/tv_sunrise"
        android:layout_width="0dp"
        android:layout_weight="0.98"
        android:layout_height="wrap_content"
        android:text="06:19"
        android:textSize="11sp"
        android:includeFontPadding="false"
        android:gravity="center"
        android:textColor="@color/config_text_secondary"/>

    <!-- Dhuhr -->
    <TextView
        android:id="@+id/tv_dhuhr"
        android:layout_width="0dp"
        android:layout_weight="0.98"
        android:layout_height="wrap_content"
        android:text="12:19"
        android:textSize="11sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:gravity="center"
        android:textColor="@color/config_text_primary"/>

    <!-- Asr -->
    <TextView
        android:id="@+id/tv_asr"
        android:layout_width="0dp"
        android:layout_weight="0.98"
        android:layout_height="wrap_content"
        android:text="15:37"
        android:textSize="11sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:gravity="center"
        android:textColor="@color/config_text_primary"/>

    <!-- Maghrib -->
    <TextView
        android:id="@+id/tv_maghrib"
        android:layout_width="0dp"
        android:layout_weight="0.98"
        android:layout_height="wrap_content"
        android:text="18:14"
        android:textSize="11sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:gravity="center"
        android:textColor="@color/config_text_primary"/>

    <!-- Isha -->
    <TextView
        android:id="@+id/tv_isha"
        android:layout_width="0dp"
        android:layout_weight="0.98"
        android:layout_height="wrap_content"
        android:text="19:27"
        android:textSize="11sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:gravity="center"
        android:textColor="@color/config_text_primary"/>
</LinearLayout>
