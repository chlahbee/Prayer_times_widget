<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:padding="8dp">

    <!-- Header: Next Prayer & Countdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left: Label, Name, Location -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_next_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة القادمة"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>

            <TextView
                android:id="@+id/tv_next_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textSize="17sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"/>

            <TextView
                android:id="@+id/tv_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الدار البيضاء"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>
        </LinearLayout>

        <!-- Right: Time & Countdown -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18:00"
                android:textSize="19sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_accent"/>

            <TextView
                android:id="@+id/tv_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بعد 1س 23د"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>
        </LinearLayout>

        <!-- Minimalist Toggle Button -->
        <TextView
            android:id="@+id/btn_expand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▲"
            android:textSize="11sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="@color/widget_button_text"
            android:background="@drawable/bg_button_minimal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"/>
    </LinearLayout>

    <!-- HORIZONTAL Layout for Wide Widgets (e.g. 5x1, 4x1) -->
    <LinearLayout
        android:id="@+id/ll_all_prayers_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:paddingVertical="4dp"
        android:paddingHorizontal="2dp"
        android:background="@drawable/bg_prayers_card"
        android:visibility="visible"
        android:weightSum="6">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textSize="9sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>
            <TextView
                android:id="@+id/tv_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04:58"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الشروق"
                android:textSize="9sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>
            <TextView
                android:id="@+id/tv_time_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="06:26"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textSize="9sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>
            <TextView
                android:id="@+id/tv_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:16"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textSize="9sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>
            <TextView
                android:id="@+id/tv_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15:27"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textSize="9sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>
            <TextView
                android:id="@+id/tv_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18:00"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textSize="9sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>
            <TextView
                android:id="@+id/tv_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19:14"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"/>
        </LinearLayout>
    </LinearLayout>

    <!-- VERTICAL Layout for Tall Widgets (e.g. 2x3, 2x5) -->
    <LinearLayout
        android:id="@+id/ll_all_prayers_vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:paddingVertical="4dp"
        android:paddingHorizontal="8dp"
        android:background="@drawable/bg_prayers_card"
        android:visibility="gone">

        <!-- Fajr Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>
            <TextView
                android:id="@+id/tv_time_fajr_v"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04:58"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"/>
        </LinearLayout>

        <!-- Sunrise Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="الشروق"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>
            <TextView
                android:id="@+id/tv_time_sunrise_v"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="06:26"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"/>
        </LinearLayout>

        <!-- Dhuhr Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>
            <TextView
                android:id="@+id/tv_time_dhuhr_v"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:16"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"/>
        </LinearLayout>

        <!-- Asr Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>
            <TextView
                android:id="@+id/tv_time_asr_v"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15:27"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"/>
        </LinearLayout>

        <!-- Maghrib Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>
            <TextView
                android:id="@+id/tv_time_maghrib_v"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18:00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"/>
        </LinearLayout>

        <!-- Isha Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"/>
            <TextView
                android:id="@+id/tv_time_isha_v"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19:14"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
