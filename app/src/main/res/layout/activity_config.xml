<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/config_background">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/config_header"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مواقيت الصلاة بالمغرب"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/config_header_text"/>

            <TextView
                android:id="@+id/tv_coords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المدينة: الدار البيضاء"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:textColor="@color/config_header_accent"/>
        </LinearLayout>

        <!-- Dark/Light Mode Button -->
        <Button
            android:id="@+id/btn_theme_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الوضع الليلي"
            android:textColor="@color/config_toggle_text"
            android:backgroundTint="@color/config_toggle_background"
            style="@style/Widget.MaterialComponents.Button"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Location Settings Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@color/config_card_background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تحديد الموقع الجغرافي"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"
                    android:textColor="@color/config_text_primary"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_gps"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="تحديد عبر GPS"
                        android:textColor="@color/config_secondary_button_text"
                        android:backgroundTint="@color/config_secondary_button_background"
                        style="@style/Widget.MaterialComponents.Button"/>

                    <Button
                        android:id="@+id/btn_save"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="حفظ وتثبيت الويدجت"
                        android:textColor="@color/config_accent_button_text"
                        android:backgroundTint="@color/config_accent"
                        android:layout_marginStart="8dp"
                        style="@style/Widget.MaterialComponents.Button"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/et_lat"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="خط العرض"
                        android:textSize="12sp"
                        android:textColor="@color/config_text_primary"
                        android:inputType="numberDecimal|numberSigned"/>

                    <EditText
                        android:id="@+id/et_lon"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="خط الطول"
                        android:textSize="12sp"
                        android:textColor="@color/config_text_primary"
                        android:inputType="numberDecimal|numberSigned"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Table Header Title -->
            <TextView
                android:id="@+id/tv_month_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مواقيت الصلاة لشهر كامل"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:textColor="@color/config_text_primary"/>

            <!-- Professional Ministry Style Table -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/config_card_background"
                android:padding="4dp">

                <!-- Table Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="6dp"
                    android:background="@color/config_header"
                    android:weightSum="7"
                    android:showDividers="middle"
                    android:divider="@drawable/table_divider">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1.1"
                        android:layout_height="wrap_content"
                        android:text="ميلادي"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1.6"
                        android:layout_height="wrap_content"
                        android:text="هجري"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="0.7"
                        android:layout_height="wrap_content"
                        android:text="الفجر"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="0.7"
                        android:layout_height="wrap_content"
                        android:text="الشروق"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="0.7"
                        android:layout_height="wrap_content"
                        android:text="الظهر"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="0.7"
                        android:layout_height="wrap_content"
                        android:text="العصر"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="0.7"
                        android:layout_height="wrap_content"
                        android:text="المغرب"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="0.7"
                        android:layout_height="wrap_content"
                        android:text="العشاء"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Loading / Rows -->
                <TextView
                    android:id="@+id/tv_loading_table"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="جاري تحميل مواقيت الشهر..."
                    android:gravity="center"
                    android:padding="20dp"
                    android:textSize="14sp"
                    android:textColor="@color/config_text_secondary"/>

                <LinearLayout
                    android:id="@+id/ll_monthly_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
